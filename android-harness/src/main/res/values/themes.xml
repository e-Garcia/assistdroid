<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The approval dialog floats over the app the agent is in, so that app stays visible and is not stopped. -->
    <style name="ApprovalTheme" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
